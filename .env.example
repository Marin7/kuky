# Used by docker-compose.yml on the VM. Copy to .env and fill in real values.
#
# Temporary IP-only HTTP smoke deploy (no domain / TLS yet).
# Upcloud's default firewall allows 80/443/8443/8880 — not 8080/8081 — so:
#   site → http://81.27.101.102          (host 80 → container 8080)
#   API  → http://81.27.101.102:8443     (host 8443 → container 8081)
# Keep COOKIE_SECURE=false until you have HTTPS.
# Rebuild the front-end image whenever VITE_* changes.

# Postgres / back-end
DB_PASSWORD=change-me

APP_JWT_SECRET=change-me-hs256-key-at-least-32-chars
COOKIE_SECURE=false
CORS_ALLOWED_ORIGIN=http://81.27.101.102

# Mail — MAIL_ENABLED=true with empty/bad MAIL_TOKEN makes /register hang on SMTP.
# For smoke deploys keep false; activate via back-end logs (after rebuild) or SQL below.
MAIL_HOST=live.smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=api
MAIL_TOKEN=
MAIL_ENABLED=false
MAIL_FROM=noreply@andreeapaula.es
TEACHER_EMAIL=andreeapaula.stinga@gmail.com

# Zoom
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_USER_ID=me

# Front-end (baked into the client bundle at build time — rebuild after changing)
FRONTEND_BASE_URL=http://81.27.101.102
VITE_API_BASE_URL=http://81.27.101.102:8443
VITE_SITE_URL=http://81.27.101.102
