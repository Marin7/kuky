# Used by docker-compose.yml on the VM. Copy to .env and fill in real values.
#
# Temporary IP-only HTTP smoke deploy (no domain / TLS yet):
#   1. Fill DB_PASSWORD, APP_JWT_SECRET, MAIL_TOKEN below
#   2. Keep COOKIE_SECURE=false (required — Secure cookies won't stick on HTTP)
#   3. docker compose up --build -d
#   4. Open http://81.27.101.102:8080
# When you add a domain + HTTPS, set COOKIE_SECURE=true and switch all URLs to https://...

# Postgres / back-end
DB_PASSWORD=change-me

APP_JWT_SECRET=change-me-hs256-key-at-least-32-chars
COOKIE_SECURE=false
CORS_ALLOWED_ORIGIN=http://81.27.101.102:8080

# Mail
MAIL_HOST=live.smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=api
MAIL_TOKEN=
MAIL_ENABLED=true
MAIL_FROM=noreply@andreeapaula.es
TEACHER_EMAIL=admin@andreeapaula.es

# Zoom
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_USER_ID=me

# Front-end (baked into the client bundle at build time — rebuild after changing)
FRONTEND_BASE_URL=http://81.27.101.102:8080
VITE_API_BASE_URL=http://81.27.101.102:8081
VITE_SITE_URL=http://81.27.101.102:8080
